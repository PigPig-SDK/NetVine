<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UI.HomeView">
    <UserControl.Styles>
        <StyleInclude Source="avares:/Styles/HomePageStyles.axaml"/>
    </UserControl.Styles>
  <Grid HorizontalAlignment="Stretch" 
        VerticalAlignment="Top"
        Grid.RowDefinitions="auto,auto,*">

      <Grid HorizontalAlignment="Center" VerticalAlignment="Top"
            Grid.Row="0"
            Grid.ColumnDefinitions="auto,auto"
            Grid.RowDefinitions="auto,auto,auto">

	      <Image x:Name="icon" Classes="largeIcon" Grid.Row="0" Grid.Column="0"/>
          <TextBlock Classes="title" Grid.Row="0" Grid.Column="1"/>
          <TextBlock Classes="slogan" Grid.Row="2" Grid.Column="1" x:Name="Slogan"/>
      </Grid>

      <ScrollViewer Grid.Row="2" Margin="10" MaxWidth="600" Background="#66000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch">
            <!-- Made by-->
            <Grid RowDefinitions="auto,auto" ColumnDefinitions="auto,auto">

		          <TextBlock Classes="developerTitle" Text="Developed by :" Grid.Row="0"/>

		          <TextBlock Classes="developerNames" Text="Aidan, Ben, Sean, Ty" Grid.Row="0" Grid.Column="1"/>
            </Grid>
            <Rectangle Classes="separator"/>
            <Grid RowDefinitions="auto,*" ColumnDefinitions="auto,*">

                  <StackPanel Grid.Row="0" HorizontalAlignment="Stretch" Margin="20">
                      <Image Classes="logTab" Height="16" Width="16"/>
		              <TextBlock Classes="developerTitle" Text="Info :" Margin="0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Margin="20">
            
                        <TextBlock  Classes="bulletPoint" 
                                   Text=">  If there is a searchbar at the top of your screen, it can be used for filtering."/>

                        <TextBlock  Classes="bulletPoint" 
                                   Text=">  Press enter to accept setting changes"/>

                        <TextBlock  Classes="bulletPoint"
                              Text=">  A processes ram is reported in total allocation"/>

                        <TextBlock  Classes="bulletPoint" 
                              Text=">  Netvine requires admin privileges in order to collect network data" />

                        <TextBlock  Classes="bulletPoint" 
                              Text=">  Settings are always saved whenever the program is closed." />

                        <TextBlock  Classes="bulletPoint" 
                        Text=">  Notifications may occur when a batch is pushed to your DB" />

                        <TextBlock  Classes="bulletPoint" 
                        Text=">  Adjusting probe rates and DB storage rates can lower overhead" />

                        <TextBlock  Classes="bulletPoint" 
                        Text=">  Currently only Windows is supported. Some day a go-getter might fix that." />

                        <TextBlock  Classes="bulletPoint" 
                        Text=">  Clients submit to a host, and cannot see a hosts data." />

                        <TextBlock  Classes="bulletPoint" 
                        Text=">  Inside the table view - You can close or save the icon of an application by rightclicking it." />

                        <TextBlock  Classes="bulletPoint" 
                              Text=">  The Configuration/Database can be found at Appdata/Roaming/Netvine, Or by clicking the button below."/>
                              <Button Margin="5" Click="OpenConfigLocation" BorderBrush="#888888" Background="#1E1E1E" HorizontalAlignment="Right" HorizontalContentAlignment="Center">
                                <Label FontSize="12" Margin="-5">Open Configuration</Label>
                              </Button>

                        <TextBlock  Classes="bulletPoint" 
                        Text=">  If you wish to modify this application, check it out on github!" />
                        <HyperlinkButton NavigateUri="https://github.com/PigPig-SDK/NetVine" Margin="5" BorderBrush="#888888" Background="#1E1E1E" HorizontalAlignment="Right">
                            <Label FontSize="12" Margin="-5">Github</Label>
                        </HyperlinkButton>

                  </StackPanel>
            </Grid>
            <Rectangle Classes="separator"/>
        </StackPanel>
      </ScrollViewer>
  </Grid>
</UserControl>
