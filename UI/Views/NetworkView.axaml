<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="450"
             x:Class="UI.NetworkView">
    <UserControl.Styles>
        <StyleInclude Source="avares:/Styles/TabStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="auto,auto, auto, *, auto, auto">
        <!-- Title -->
        <Label Grid.Row="0" Classes="title">Host</Label>
        
        <!-- Hosting -->
        <Grid Grid.Row="1" RowDefinitions="auto,auto,auto,auto">

            <StackPanel Grid.Row="0" x:Name="hostSettingsStackPannel" HorizontalAlignment="Stretch"/>
		    <Button Grid.Row="1" x:Name="ToggleHostButton" Click="ToggleHostClicked" Content="BeginHost"  Margin="0,0,10,0" HorizontalAlignment="Center"/>
            <Label x:Name="HostStatusLabel" Grid.Row="2" Content="Status"/>
        </Grid>

        <!-- Connecting -->
        <Grid Grid.Row="2" RowDefinitions="auto, auto, auto">
		    <Rectangle Grid.Row="0" Height="2" Fill="#444444" Margin="8,4" Opacity="0.5"/>

            <Label Grid.Row="1" Classes="title">Add</Label>

            <Grid Grid.Row="3" ColumnDefinitions="*,auto">
                <TextBox Grid.Column="0"  MinWidth="0" Watermark="Ip:Port" UseFloatingWatermark="True" Margin="10,0,10,0" x:Name="AddConnectionInput"/>
		        <Button Grid.Column="1" Content="Connect"  Margin="0,0,10,0" HorizontalAlignment="Center" Click="TryAddConnection"/>	
            </Grid>
        </Grid>
        <ScrollViewer Grid.Row="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >
			<StackPanel x:Name="ConnectionPanel"/>
        </ScrollViewer>

        <!-- Disconnect -->
        <Rectangle Grid.Row="4" Height="2" Fill="#444444" Margin="8,4" Opacity="0.5"/>
        <Grid Grid.Row="5" RowDefinitions="*,*,*,*">
                <!-- Live toggle -->
                <local:CustomCheckbox x:Name="disconnectBox" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                      Title="Online"
                                      ToolTip.Tip="Toggles all connections (For host and client)"
                                      CheckedChanged="CustomCheckbox_CheckedChanged"
                                      IsChecked="True" FontSize="20"
                                      UncheckedSource="avares://NetVine/Assets/plug.png" 
                                      CheckedSource="avares://NetVine/Assets/unplug.png"/>
            </Grid>
    </Grid>
</UserControl>
