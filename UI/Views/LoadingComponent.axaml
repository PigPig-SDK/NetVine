<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UI.LoadingComponent">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="LoadingBar">
        <Ellipse Width="128" Height="128" StrokeThickness="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    StrokeDashArray="32,32" Stroke="White"
                    Margin="5,0,5,0"
                    x:Name="LoadingCircle"
                    ToolTip.Tip="These things take time."
                    Fill="#40000000"/>
        <Label VerticalAlignment="Center" 
        FontFamily="avares://NetVine/Assets#Bebas Neue" FontSize="25" 
        HorizontalAlignment="Center">Loading</Label>
    </Grid>
</UserControl>
