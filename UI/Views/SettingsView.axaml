<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UI.SettingsView">
    <Grid RowDefinitions="*,Auto">
        <TreeView x:Name="SettingsTreeView" Grid.Row="0">
            <TreeView.Styles>
                <Style Selector="TreeViewItem:selected /template/ Border#PART_SelectionIndicator">
                    <Setter Property="Background" Value="#A5C882"/>
                </Style>
                <Style Selector="TreeViewItem:selected /template/ ContentPresenter">
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </Style>
                <Style Selector="TreeViewItem:selected /template/ Border">
                    <Setter Property="Background" Value="#8FB56A"/>
                </Style>
            </TreeView.Styles>
        </TreeView>
        
        <Button Content="Reset Database" Grid.Row="1"
                HorizontalAlignment="Right"
                Margin="10"
                Click="WipeDbInitialize"/>
    </Grid>    
</UserControl>
