<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:UI.ViewModels"
             x:Class="UI.ComponentView"
             x:DataType="vm:ComponentViewModel">

    <Border Background="#808080"
            BorderBrush="Black"
            BorderThickness="1"
            Padding="10">
    <StackPanel Spacing="8">
    <ComboBox ItemsSource="{Binding ChartTypes}"
              SelectedItem="{Binding SelectedChartType}"
              HorizontalAlignment="Stretch" />
    
<Grid>    
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectCpuCommand}" IsVisible="{Binding ComponentIsLive}">
        <StackPanel>
            <TextBlock Text="CPU" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonCPUText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectCpuAvgCommand}" IsVisible="{Binding ComponentIsNotLive}">
        <StackPanel>
            <TextBlock Text="CPU Avg" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonCPUAvgText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>    
</Grid>   
    
<Grid>       
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectRamCommand}" IsVisible="{Binding ComponentIsLive}">
        <StackPanel>
            <TextBlock Text="RAM" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonRAMText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectCpuPeakCommand}" IsVisible="{Binding ComponentIsNotLive}">
        <StackPanel>
            <TextBlock Text="CPU Peak" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonCPUPeakText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>
</Grid> 
    
<Grid>       
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectDiskCommand}" IsVisible="{Binding ComponentIsLive}">
        <StackPanel>
            <TextBlock Text="DISK" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonDISKText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectRamAvgCommand}" IsVisible="{Binding ComponentIsNotLive}">
        <StackPanel>
            <TextBlock Text="RAM Avg" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonRAMAvgText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>
</Grid>      
    
<Grid>      
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectNetworkCommand}" IsVisible="{Binding ComponentIsLive}">
        <StackPanel>
            <TextBlock Text="NET" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonNetworkText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectRamPeakCommand}" IsVisible="{Binding ComponentIsNotLive}">
        <StackPanel>
            <TextBlock Text="RAM Peak" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonRAMPeakText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>
</Grid>   
    
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectDiskAvgCommand}" IsVisible="{Binding ComponentIsNotLive}">
        <StackPanel>
            <TextBlock Text="DISK Avg" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonDISKAvgText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>
    
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectDiskPeakCommand}" IsVisible="{Binding ComponentIsNotLive}">
        <StackPanel>
            <TextBlock Text="DISK Peak" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonDISKPeakText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>
    
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectNetworkAvgCommand}" IsVisible="{Binding ComponentIsNotLive}">
        <StackPanel>
            <TextBlock Text="NET Avg" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonNetworkAvgText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>
    
    <Button HorizontalAlignment="Stretch" Command="{Binding SelectNetworkPeakCommand}" IsVisible="{Binding ComponentIsNotLive}">
        <StackPanel>
            <TextBlock Text="NET Peak" FontWeight="Bold" />
            <TextBlock Text="{Binding ButtonNetworkPeakText}" FontSize="11" Opacity="0.8" />
        </StackPanel>
    </Button>
    
        </StackPanel>
    </Border>
</UserControl>

