<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="60"
             xmlns:local="using:UI"
             x:Class="UI.ToastBody">
    <Button 
    HorizontalAlignment="Stretch"
    CornerRadius="0 16 0 16"
    Click="PullOpenWindow"
    Background="#80000000">
      <Grid
      HorizontalAlignment="Stretch" 
      VerticalAlignment="Stretch">
        <Image 
        Source="/Assets/netvine_tiny_toast.png" 
        ClipToBounds="True"
        Width="100"
        Height="100"
        Margin="10"
        HorizontalAlignment="Left"/>
        <Ellipse Width="15" StrokeThickness="2" 
        HorizontalAlignment="Left"
        StrokeDashArray="5,2" Stroke="Black" 
        Height="15" Margin="5,0,5,0" 
        Fill="LightGreen" x:Name="ActivityCircle"/>
        <TextBlock x:Name="NotificationBody"
        Text="{Binding Title, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ToastBody}}"
        VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>
  </Button>
</UserControl>
