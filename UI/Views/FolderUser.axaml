<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="30"
             x:Class="UI.FolderUser">
  <Button HorizontalAlignment="Stretch" x:Name="SelectionButton" Height="45" Click="OnClicked">
      <Grid ColumnDefinitions="auto,*">
          <Ellipse Width="10" Height="10" Fill="LightGreen" x:Name="OnlineCircle" Grid.Column="0"/>
          <Label Grid.Column="1" HorizontalAlignment="Stretch" x:Name="UsernameLabel" VerticalAlignment="Center" FontSize="20">Username</Label>
      </Grid>
  </Button>
</UserControl>
