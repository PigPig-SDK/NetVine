<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="30"
             x:Class="UI.FolderUser">
    <Panel>

        <Border Padding="10" Background="Transparent">
            <Button HorizontalAlignment="Stretch" CornerRadius="0,8,8,0" x:Name="SelectionButton" Height="45" Click="OnClicked">
                <Button.Effect>
                    <DropShadowEffect Color="Black" 
                                          BlurRadius="25" 
                                          OffsetX="0" 
                                          OffsetY="5" 
                                          Opacity="0.75"/>
                </Button.Effect>
                <Grid ColumnDefinitions="auto,*">
                    <Ellipse Width="10" Height="10" Fill="LightGreen" x:Name="OnlineCircle" Grid.Column="0"/>
                    <Grid RowDefinitions="auto,auto" Grid.Column="1">
                        <Label Grid.Row="0" HorizontalAlignment="Stretch" Padding="0" Margin="0" x:Name="UsernameLabel" VerticalAlignment="Center" FontSize="20">Username</Label>
                        <Label Grid.Row="1" Foreground="Black" HorizontalAlignment="Stretch" Padding="0" Margin="0" x:Name="Subscript" VerticalAlignment="Top" FontSize="10">TODO: put IP address here.</Label>
                    </Grid>
                </Grid>
            </Button>
        </Border>
    </Panel>
</UserControl>
