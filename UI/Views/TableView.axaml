<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UI.ViewModels"
             x:Class="UI.TableView"
             x:DataType="vm:TableViewModel"> <Grid RowDefinitions="Auto, *">
        
        <DataGrid Grid.Row="1"
                  x:Name="MyDataGrid"
                  CanUserResizeColumns="True"
                  ItemsSource="{Binding TableRowsView}" 
                  Sorting="DataGridSorting"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  GridLinesVisibility="All">
            <!--<DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding CpuMenuText}" Command="{Binding ToggleCpuCommand}"/>
                    <MenuItem Header="{Binding MemoryMenuText}" Command="{Binding ToggleMemoryCommand}"/>
                    <MenuItem Header="{Binding DiskMenuText}" Command="{Binding ToggleDiskCommand}"/>
                    <MenuItem Header="{Binding NetworkMenuText}" Command="{Binding ToggleNetworkCommand}"/>
                    <MenuItem Header="Select Timeframe" x:Name="TimeFrameSelectionOption" IsEnabled="False" Command="{Binding OpenTimeframeCommand}"/>
                    <MenuItem Header="{Binding AllMenuText}" Command="{Binding ToggleAllCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>-->

            <DataGrid.Styles>
                <!-- 1. Context Menu for the BODY (Rows) -->
                <Style Selector="DataGridRow">
                    <Setter Property="ContextMenu">
                        <ContextMenu Opened="ContextMenuOpened" 
                                     Closed="ContextMenuClosed">
                            <MenuItem Click="OnSaveIconClick" Header="Save Icon">
                                <MenuItem.Icon>
                                    <Image Source="/Assets/save.png" 
                                            Width="32" Height="32" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="EndProgramMenuItem" Click="OnEndProgramClick" Header="Kill program">
                                <MenuItem.Icon>
                                    <Image Source="/Assets/close.png" 
                                            Width="32" Height="32" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Setter>
                </Style>

                <!-- 2. Context Menu for the HEADERS -->
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="ContextMenu">
                        <ContextMenu>
                            <MenuItem Header="{Binding CpuMenuText}" Command="{Binding ToggleCpuCommand}"/>
                            <MenuItem Header="{Binding MemoryMenuText}" Command="{Binding ToggleMemoryCommand}"/>
                            <MenuItem Header="{Binding DiskMenuText}" Command="{Binding ToggleDiskCommand}"/>
                            <MenuItem Header="{Binding NetworkMenuText}" Command="{Binding ToggleNetworkCommand}"/>
                            <MenuItem Header="Select Timeframe" x:Name="TimeFrameSelectionOption" IsEnabled="False" Command="{Binding OpenTimeframeCommand}"/>
                            <MenuItem Header="{Binding AllMenuText}" Command="{Binding ToggleAllCommand}"/>
                        </ContextMenu>
                    </Setter>
                </Style>
            </DataGrid.Styles>


            <DataGrid.Columns>

                <DataGridTextColumn Header="PC Name" 
                                    Binding="{Binding (vm:TableRow).SystemName}" 
                                    IsVisible="True"
                                    Width="Auto"/>
                
                <DataGridTemplateColumn Header="Process" Width="*" MinWidth="100"
                                        CanUserSort="True"
                                        SortMemberPath="AppName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TableRow">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center" Margin="4 0">
                                <Image Source="{Binding AppIcon}"
                                       Width="16" Height="16"
                                       IsVisible="{Binding AppIcon,
                                           Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <TextBlock Text="{Binding AppName}"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding AppName}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="CPU"     
                                    Binding="{Binding (vm:TableRow).LiveData.CpuUsage, StringFormat={}{0:F2}%}" 
                                    IsVisible="{Binding ShowCpuLive}"
                                    Width="*" MinWidth="100"/>
                
                <DataGridTextColumn Header="Memory"  
                                    Binding="{Binding (vm:TableRow).LiveData.MemoryUsage, StringFormat={}{0:F2}}" 
                                    IsVisible="{Binding ShowMemoryLive}"
                                    Width="*" MinWidth="100"/>

                <DataGridTextColumn Header="Disk"  
                                    Binding="{Binding (vm:TableRow).LiveData.DiskUsage, StringFormat={}{0:F2}}" 
                                    IsVisible="{Binding ShowDiskLive}"
                                    Width="*" MinWidth="100"/>

                <DataGridTextColumn Header="Network"  
                                    Binding="{Binding (vm:TableRow).LiveData.NetworkUsage, StringFormat={}{0:F2}}" 
                                    IsVisible="{Binding ShowNetworkLive}"
                                    Width="*" MinWidth="100"/>

                <DataGridTextColumn Header="CPU Avg"
                                    Binding="{Binding (vm:TableRow).HistoricalData.CpuUsageAvg, StringFormat={}{0:F2}%}"
                                    IsVisible="{Binding ShowCpuHistorical}"
                                    Width="*" />

                <DataGridTextColumn Header="CPU Top"
                                    Binding="{Binding (vm:TableRow).HistoricalData.CpuUsagePeak, StringFormat={}{0:F2}%}"
                                    IsVisible="{Binding ShowCpuHistorical}"
                                    Width="*"/>

                <DataGridTextColumn Header="Memory Avg"
                                    Binding="{Binding (vm:TableRow).HistoricalData.MemoryUsageAvg, StringFormat={}{0:F2}}"
                                    IsVisible="{Binding ShowMemoryHistorical}"
                                    Width="*"/>

                <DataGridTextColumn Header="Memory Top"
                                    Binding="{Binding (vm:TableRow).HistoricalData.MemoryUsagePeak, StringFormat={}{0:F2}}"
                                    IsVisible="{Binding ShowMemoryHistorical}"
                                    Width="*"/>

                <DataGridTextColumn Header="Disk Avg"
                                    Binding="{Binding (vm:TableRow).HistoricalData.DiskUsageAvg, StringFormat={}{0:F2}}"
                                    IsVisible="{Binding ShowDiskHistorical}"
                                    Width="*"/>

                <DataGridTextColumn Header="Disk Top"
                                    Binding="{Binding (vm:TableRow).HistoricalData.DiskUsagePeak, StringFormat={}{0:F2}}"
                                    IsVisible="{Binding ShowDiskHistorical}"
                                    Width="*"/>

                <DataGridTextColumn Header="Network Avg"
                                    Binding="{Binding (vm:TableRow).HistoricalData.NetworkUsageAvg, StringFormat={}{0:F2}}"
                                    IsVisible="{Binding ShowNetworkHistorical}"
                                    Width="*"/>

                <DataGridTextColumn Header="Network Top"
                                    Binding="{Binding (vm:TableRow).HistoricalData.NetworkUsagePeak, StringFormat={}{0:F2}}"
                                    IsVisible="{Binding ShowNetworkHistorical}"
                                    Width="*"/>

                <DataGridTextColumn Header="Network Total"
                                    Binding="{Binding (vm:TableRow).HistoricalData.NetworkUsageTotal, StringFormat={}{0:F2}}"
                                    IsVisible="{Binding ShowNetworkHistorical}"
                                    Width="*"/>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
