<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UI.FolderView">
	<Border Padding="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#99282838" Offset="0"/>
                <GradientStop Color="#99222228" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                              BlurRadius="50" 
                              OffsetX="0" 
                              OffsetY="4" 
                              Opacity="0.5"/>
        </Border.Effect>

        <Grid RowDefinitions="auto,auto,*,auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,auto">
                <Label Grid.Column="0" HorizontalAlignment="Center" FontSize="30" 
                       FontFamily="avares://NetVine/Assets#Bebas Neue"
                       VerticalAlignment="Center">Systems</Label>
                <Button Grid.Column="1" MaxHeight="30" MaxWidth="40" Content="⚙️" 
                        HorizontalContentAlignment="Center"  VerticalContentAlignment="Center" 
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Rectangle Grid.Row="1" Height="2" Fill="#444444" Margin="8,4" Opacity="0.5"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="2">
                <StackPanel x:Name="ScrollView">
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="3" RowDefinitions="auto,auto">
                <!-- Slight padding. -->
                <Rectangle Grid.Row="0" Height="2" Fill="#444444" Margin="8,4" Opacity="0.5"/>
                <!-- Live button -->
                <CheckBox Checked="LiveViewChecked" Unchecked="LiveViewUnchecked" Grid.Row="1" HorizontalAlignment="Center" ToolTip.Tip="Toggle the database viewing for only live data">
                <CheckBox.Template>
                    <ControlTemplate>
                        <Border Background="Transparent"
                                BorderBrush="#888888"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="8,8">
                            <Border.Styles>
                                <Style Selector=":pointerover > Border">
                                    <Setter Property="Background" Value="#22ffffff"/>
                                </Style>
                            </Border.Styles>
                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                <!-- Custom sprite checkbox box -->
                                <Panel Grid.Column="0" Width="24" Height="24">
                                    <!-- Unchecked -->
                                    <Image Source="/Assets/live_icon.png"
                                           IsVisible="{Binding !IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <!-- Checked -->
                                    <Image Source="/Assets/live_icon_ticked.png"
                                           IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                </Panel>
                                <!-- Label -->
                                <Label Grid.Column="1" HorizontalAlignment="Stretch" FontSize="25"  VerticalAlignment="Bottom" 
                                       FontFamily="avares://NetVine/Assets#Bebas Neue"
                                       Margin="8,0,0,0">LIVE</Label>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </CheckBox.Template>
            </CheckBox>
            </Grid>
        </Grid>
	</Border>

</UserControl>
