<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Add Resources Here -->
  <!-- https://docs.avaloniaui.net/docs/guides/styles-and-resources/resources -->
  
  <SolidColorBrush x:Key="TableBackground">#808080</SolidColorBrush>
  <SolidColorBrush x:Key="TextColor">#000000</SolidColorBrush>
  <SolidColorBrush x:Key="BorderColor">#000000</SolidColorBrush>
  <SolidColorBrush x:Key="HighlightColor">#FF0000</SolidColorBrush>
  <SolidColorBrush x:Key="SelectionColor">#00FF00</SolidColorBrush>

</ResourceDictionary>
