<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:UI.ViewModels"
             xmlns:local="using:UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="450"
             x:Class="UI.LogView"
             x:DataType="vm:LogViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares:/Styles/TabStyles.axaml"/>
    </UserControl.Styles>
    <Grid RowDefinitions="auto,auto,auto,*,auto">

        <!-- Title -->
        <Label Grid.Row="0" Classes="title">Log</Label>

        <!-- Divider -->
        <Rectangle Grid.Row="1" Height="2" Fill="#444444" Margin="8,4" Opacity="0.5"/>

        <!-- Filter bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="10,0,10,0">
            <TextBox Grid.Column="0"
                     Watermark="Filter events..."
                     UseFloatingWatermark="True"
                     Margin="0,0,6,0"
                     MinWidth="0"/>
            <ComboBox Grid.Column="1"
                      SelectedIndex="0"
                      Width="90">
                <ComboBoxItem>ALL</ComboBoxItem>
                <ComboBoxItem>INFO</ComboBoxItem>
                <ComboBoxItem>WARN</ComboBoxItem>
                <ComboBoxItem>ERROR</ComboBoxItem>
            </ComboBox>
        </Grid>

        <!-- Log entries -->
        <ScrollViewer Grid.Row="3" VerticalAlignment="Stretch" Padding="10" HorizontalAlignment="Stretch">
            <ListBox ItemsSource="{Binding LogEntries}"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TimeDelta}"
                                       Foreground="#888"
                                       Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Priority}"
                                       Foreground="{Binding LevelColor}"
                                       Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Message}"
                                       TextWrapping="NoWrap"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- Divider -->
        <Rectangle Grid.Row="4" Height="2" Fill="#444444" Margin="8,4" Opacity="0.5"/>

    </Grid>
</UserControl>