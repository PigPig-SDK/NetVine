<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:UI.ViewModels"
             xmlns:local="using:UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="450"
             x:Class="UI.LogView"
             x:DataType="vm:LogViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares:/Styles/TabStyles.axaml"/>
    </UserControl.Styles>
    <Grid RowDefinitions="auto,auto,auto,*,auto">

        <!-- Title -->
        <Label Grid.Row="0" Classes="title">Log</Label>

        <!-- Divider -->
        <Rectangle Grid.Row="1" Height="2" Fill="#444444" Margin="8,4" Opacity="0.5"/>

        <!-- Filter bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto, Auto" Margin="10,0,10,0">
            <TextBox Grid.Column="0"
                     Watermark="Filter events..."
                     UseFloatingWatermark="True"
                     KeyUp="SearchBar_KeyUp"
                     x:Name="SearchBar"
                     Margin="0,0,6,0"
                     MinWidth="0"/>
            <ComboBox Grid.Column="1"
                      SelectedIndex="0"
                      x:Name="TypeFilter"
                      SelectionChanged="TypeFilter_SelectionChanged"
                      Width="64">
                <ComboBoxItem Tag="All">
                        <Ellipse Width="15" StrokeThickness="2"
                             HorizontalAlignment="Center"
                             ToolTip.Tip="All"
                             Height="15"
                             Fill="White"/>
                </ComboBoxItem>
                <ComboBoxItem Tag="Message">  
                    <Ellipse Width="15" StrokeThickness="2"
                            HorizontalAlignment="Center"
                            ToolTip.Tip="Messages"
                            Height="15"
                            Fill="#A5c882"/>
                </ComboBoxItem>
                <ComboBoxItem Tag="Alert">  
                    <Ellipse Width="15" StrokeThickness="2"
                            HorizontalAlignment="Center"
                            ToolTip.Tip="Alerts"
                            Height="15"
                            Fill="#FFEE8C"/>
                </ComboBoxItem>
                <ComboBoxItem Tag="Warning">
                        <Ellipse Width="15" StrokeThickness="2"
                             HorizontalAlignment="Center"
                             ToolTip.Tip="Warnings"
                             Height="15"
                             Fill="#C88282"/>
                </ComboBoxItem>
            </ComboBox>
            <Button Click="ClearMessages" Grid.Column="2" Height="32" BorderBrush="#888888" Background="#1E1E1E" Margin="5,0" ToolTip.Tip="Clear All">
                <Image Source="/Assets/trash.png" HorizontalAlignment="Stretch"/>
            </Button>
        </Grid>

        <!-- Log entries -->
        <ScrollViewer Grid.Row="3" VerticalAlignment="Stretch" Padding="10" HorizontalAlignment="Stretch">
            <ListBox ItemsSource="{Binding LogEntries}"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ Border">
                        <Setter Property="Background" Value="transparent"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,Auto,*">
                            <Ellipse Grid.Column="1" Width="15" StrokeThickness="2"
                                    HorizontalAlignment="Left"
                                    ToolTip.Tip="{Binding Priority}"
                                    Height="15" Margin="5"
                                    Fill="{Binding LevelColor}"/>
                            <TextBlock Grid.Column="0"
                                        VerticalAlignment="Center"
                                       Text="{Binding TimeDelta}"
                                       Foreground="#888"/>
                            <TextBlock Grid.Column="2"
                            VerticalAlignment="Center"
                                       Text="{Binding Message}"
                                       TextWrapping="NoWrap"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <StackPanel Grid.Row="4">
            <Rectangle  Height="2" Fill="#444444" Margin="8,4" Opacity="0.5"/>
        </StackPanel>
    </Grid>
</UserControl>