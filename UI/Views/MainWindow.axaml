<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:UI.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UI.Views.MainWindow"
        xmlns:views="clr-namespace:UI"
        Icon="/Assets/avalonia-logo.ico"
        Title="MainWindow">
    
    <Grid ColumnDefinitions="*, 1, 150">
        
        <TabControl Grid.Column="0">
            
            <TabItem Header="Tab1">
                
                <Grid ColumnDefinitions="150, 1, *">
                    
                    <views:ComponentView Grid.Column="0" />

                    <GridSplitter Grid.Column="1" Background="Transparent" Width="6" />

                    <views:Canvas Grid.Column="2" />
                </Grid>
            </TabItem>
            
            <TabItem Header="Tab2">
                <Border Background="LightGray" Margin="10" CornerRadius="8">
                    <TextBlock Text="Content Goes Here"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="1" Background="Transparent" Width="6" />

        <views:FolderView Grid.Column="2" />
    </Grid>
</Window>
