<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StyleInclude Source="avares:/Styles/MainStyle.axaml"/>

    <Style Selector="Image.largeIcon">
        <Setter Property="Width" Value="128"/>
        <Setter Property="Source" Value="/Assets/netvine.png"/>
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Text" Value="Net-Vine"/>
        <Setter Property="FontSize" Value="128"/>
        <Setter Property="Margin" Value="0,20,0,0" />
        <Setter Property="FontFamily" Value="avares://NetVine/Assets#Bebas Neue"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.slogan">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Text" Value="AutoGeneratedtext"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontFamily" Value="avares://NetVine/Assets#Bebas Neue"/>
        <Setter Property="Margin" Value="0,-20,0,0"/>
    </Style>

    <Style Selector="TextBlock.developerTitle">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontFamily" Value="avares://NetVine/Assets#Bebas Neue"/>
        <Setter Property="Margin" Value="20,20,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="TextBlock.developerNames">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontFamily" Value="avares://NetVine/Assets#Bebas Neue"/>
        <Setter Property="Margin" Value="100,20,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style Selector="TextBlock.bulletPoint">
		<Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="20,20,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
</Styles>
